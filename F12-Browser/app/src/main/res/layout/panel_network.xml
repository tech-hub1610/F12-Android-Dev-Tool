<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black">

    <!-- Filter and Controls Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="@color/bg_dark">

        <EditText
            android:id="@+id/network_search"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_edittext"
            android:hint="Filter URL..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="13sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_filter_type"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingHorizontal="14dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_dark"
            android:text="ALL"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_clear_network"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_delete"
            android:contentDescription="Clear" />

        <ImageButton
            android:id="@+id/btn_export_network"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_share"
            android:contentDescription="Export HAR/JSON" />
    </LinearLayout>

    <!-- Table Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        android:background="@color/bg_surface">

        <TextView
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="METHOD"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NAME / PATH"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="TYPE"
            android:gravity="end"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:text="TIME"
            android:gravity="end"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- Requests RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_network"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />
</LinearLayout>
