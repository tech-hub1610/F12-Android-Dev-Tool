<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- Logo & Title Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/ic_f12_logo"
                android:contentDescription="F12 Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="F12 Browser"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MOBILE DEVELOPER TOOLS"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- Dashboard Search Card -->
        <LinearLayout
            android:id="@+id/dash_search_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_search_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/dash_search_input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="Search Google or enter address..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri" />

            <TextView
                android:id="@+id/dash_btn_go"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:text="GO"
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Speed Dial Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPEED DIAL"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Speed Dial Grid (Row 1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="14dp">

            <!-- Google -->
            <LinearLayout
                android:id="@+id/dial_google"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="G"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Google"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- GitHub -->
            <LinearLayout
                android:id="@+id/dial_github"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="GH"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="GitHub"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- MDN Docs -->
            <LinearLayout
                android:id="@+id/dial_mdn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="MDN"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="MDN Docs"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Stack Overflow -->
            <LinearLayout
                android:id="@+id/dial_stackoverflow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="SO"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="StackOverflow"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Speed Dial Grid (Row 2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <!-- Can I Use -->
            <LinearLayout
                android:id="@+id/dial_caniuse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="CIU"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Can I Use"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Localhost:3000 -->
            <LinearLayout
                android:id="@+id/dial_localhost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text=":3000"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Localhost"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Emulator:8080 -->
            <LinearLayout
                android:id="@+id/dial_emulator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text=":8080"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Emulator"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Test Sandbox -->
            <LinearLayout
                android:id="@+id/dial_sandbox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_speed_dial_icon"
                    android:gravity="center"
                    android:text="&lt;/&gt;"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Sandbox"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bookmarks Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BOOKMARKS"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dash_view_all_bookmarks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View All"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dash_bookmarks_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- Recent History Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RECENT HISTORY"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dash_view_all_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View All"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dash_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
