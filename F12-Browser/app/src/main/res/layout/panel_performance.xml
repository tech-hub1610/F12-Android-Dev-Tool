<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Recording and Refresh Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_record_perf"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_button_white"
                android:text="● START RECORDING"
                android:textColor="@color/bg_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_refresh_perf"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:paddingHorizontal="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_dark"
                android:text="REFRESH"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Live Recording Indicator -->
        <TextView
            android:id="@+id/text_recording_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recording live timeline metrics..."
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@drawable/bg_code_box"
            android:padding="8dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Navigation Milestones Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NAVIGATION TIMING (W3C)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/text_perf_navigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="14dp" />

        <!-- Paint Timing Card -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAINT TIMING"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/text_perf_paint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="14dp" />

        <!-- DOM and Resource Composition -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAGE COMPOSITION &amp; DOM METRICS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/text_perf_composition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="14dp" />

        <!-- Memory / Runtime JS Heap -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JAVASCRIPT HEAP &amp; MEMORY"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/text_perf_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
