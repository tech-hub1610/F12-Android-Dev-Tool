<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_modal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- Search Engine -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEFAULT SEARCH ENGINE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_setting_engine"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_dark"
            android:text="Google"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Homepage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOMEPAGE URL"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edit_setting_homepage"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_toolbar_edittext"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:layout_marginBottom="16dp" />

        <!-- Appearance & Theme -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="THEME / APPEARANCE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_setting_theme"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_dark"
            android:text="Dark Theme"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Dashboard CDN Wallpaper -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DASHBOARD CDN WALLPAPER"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/chk_setting_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable Dashboard CDN Wallpaper"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:buttonTint="@color/accent_white"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_setting_wallpaper_preset"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_dark"
            android:text="Wallpaper: Abstract Flow"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Developer Preferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVELOPER PREFERENCES"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <CheckBox
            android:id="@+id/chk_preserve_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preserve console &amp; network logs across navigations"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:buttonTint="@color/accent_white"
            android:layout_marginBottom="16dp" />

        <!-- Google Integration & Data Sync -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GOOGLE ACCOUNT &amp; DATA SYNC"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_setting_google_account"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_dark"
                android:text="👤 Google Account"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_setting_google_takeout"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="📦 Google Takeout"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_setting_import_chrome_bm"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_dark"
                android:text="📥 Import Bookmarks"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_setting_export_chrome_bm"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="📤 Export Bookmarks"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_setting_import_history"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_dark"
                android:text="📥 Import History"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_setting_export_backup"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="💾 Backup All Data"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Clear Browsing Data -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRIVACY &amp; DATA"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btn_clear_data"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_dark"
            android:text="CLEAR BROWSING DATA (CACHE, COOKIES, HISTORY)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginBottom="24dp" />

        <!-- About -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ABOUT F12 BROWSER"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:text="F12 Browser — Mobile Developer Tools\nVersion: 1.1.0 (Native Android APK)\nArchitecture: Java + Android XML\nTheme: Minimalist Black &amp; White\nBuild: Android SDK 34 / AGP 8.2\nEngine: Chromium-based Android WebView"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
