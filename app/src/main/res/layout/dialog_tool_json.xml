<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_modal">

    <EditText
        android:id="@+id/json_input"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_code_box"
        android:hint="Paste JSON string here..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="top"
        android:padding="8dp"
        android:inputType="textMultiLine" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_json_format"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_white"
            android:text="FORMAT PRETTY"
            android:textColor="@color/bg_black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_json_minify"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_dark"
            android:text="MINIFY"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/json_output"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_code_box"
        android:textColor="@color/text_primary"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:scrollbars="vertical"
        android:textIsSelectable="true" />
</LinearLayout>
