<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modal"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_speed_dial_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Speed Dial"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Name / Title Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TITLE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_dial_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_toolbar_edittext"
        android:hint="e.g. Google or My Project"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:inputType="textCapWords"
        android:layout_marginBottom="14dp" />

    <!-- URL Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="URL"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_dial_url"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_toolbar_edittext"
        android:hint="https://example.com"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:inputType="textUri"
        android:layout_marginBottom="14dp" />

    <!-- Short Code / Monogram Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SHORT CODE / INITIALS (OPTIONAL)"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edit_dial_shortcode"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_toolbar_edittext"
        android:hint="e.g. GH, MDN, :8080 (auto if empty)"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="13sp"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:maxLength="5"
        android:layout_marginBottom="20dp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <Button
            android:id="@+id/btn_dial_delete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_dark"
            android:text="Delete"
            android:textColor="#FF5555"
            android:textSize="12sp"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_dial_cancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_dark"
            android:text="Cancel"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_dial_save"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_white"
            android:text="Save"
            android:textColor="@color/bg_black"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
