<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modal"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Browsing History"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_clear_history"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_dark"
            android:text="CLEAR HISTORY"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Google Account & History Sync Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_monochrome"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txt_google_sync_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Google Account Sync"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_google_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_button_white"
                android:text="Account"
                android:textColor="@color/bg_black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_hist_import_takeout"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_button_dark"
                android:text="📥 Import Takeout"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_hist_export_takeout"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_dark"
                android:text="📤 Export Takeout"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_google_my_activity"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/bg_button_dark"
            android:text="🌐 Open Google Chrome MyActivity"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/history_search"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_toolbar_edittext"
        android:hint="Search history..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_tertiary"
        android:textSize="12sp"
        android:paddingHorizontal="10dp"
        android:singleLine="true" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_history"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />
</LinearLayout>
