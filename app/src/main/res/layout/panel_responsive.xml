<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Preset Devices -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE VIEWPORT PRESETS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_preset_iphone"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_button_dark"
                android:text="iPhone 14/15\n393 × 852"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_preset_pixel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_button_dark"
                android:text="Pixel 7/8\n412 × 915"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_preset_ipad"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_button_dark"
                android:text="iPad Mini / Air\n768 × 1024"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btn_preset_desktop"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_button_dark"
                android:text="Desktop 1080p\n1920 × 1080"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_preset_reset"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_dark"
            android:text="RESET TO NATIVE DEVICE VIEWPORT"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <!-- Orientation and Dimensions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOM DIMENSIONS &amp; ORIENTATION"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/input_width"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toolbar_edittext"
                android:hint="Width (px)"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="12sp"
                android:paddingHorizontal="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" × "
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:paddingHorizontal="8dp" />

            <EditText
                android:id="@+id/input_height"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toolbar_edittext"
                android:hint="Height (px)"
                android:inputType="number"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="12sp"
                android:paddingHorizontal="10dp" />

            <Button
                android:id="@+id/btn_apply_dimensions"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="14dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_white"
                android:text="APPLY"
                android:textColor="@color/bg_black"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_orientation"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_dark"
            android:text="⇄ ROTATE (PORTRAIT ↔ LANDSCAPE)"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <!-- Media Query Diagnostics -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE MEDIA QUERIES"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_media_queries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_monochrome"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
