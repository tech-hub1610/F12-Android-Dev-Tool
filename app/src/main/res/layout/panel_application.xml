<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_black">

    <!-- Storage Type Subtabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/bg_dark">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp">

            <TextView
                android:id="@+id/tab_storage_local"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tab_selected"
                android:text="LOCAL STORAGE"
                android:textColor="@color/bg_black"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_storage_session"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="SESSION STORAGE"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_storage_cookies"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="COOKIES"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tab_storage_indexeddb"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tab_unselected"
                android:text="INDEXEDDB"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Search and Actions Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="@color/bg_surface">

        <EditText
            android:id="@+id/storage_search"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_edittext"
            android:hint="Search keys or values..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/btn_add_storage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_dark"
            android:text="+ ADD"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_clear_storage"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingHorizontal="12dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_dark"
            android:text="CLEAR ALL"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_refresh_storage"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackground"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <!-- Storage Items List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_storage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />
</LinearLayout>
