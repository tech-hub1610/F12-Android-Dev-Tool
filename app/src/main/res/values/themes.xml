<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.F12Browser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/bg_black</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_white</item>
        <item name="colorSecondaryVariant">@color/accent_gray</item>
        <item name="colorOnSecondary">@color/bg_black</item>
        
        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Status bar and Navigation bar -->
        <item name="android:statusBarColor">@color/bg_black</item>
        <item name="android:navigationBarColor">@color/bg_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Global Button Styling: disable auto-tinting and margin insets -->
        <item name="materialButtonStyle">@style/Widget.F12.Button</item>
    </style>

    <style name="Widget.F12.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="rippleColor">#22000000</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
